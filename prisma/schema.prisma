// AI Product Lab — Foundation schema.
// Only the 9 entities needed for this pass exist here: identity/tenancy, Project,
// the Agent registry, and the two Memory + AuditLog scaffolds. LAP, Finding,
// Decision, Task, AgentExecution and TokenUsage are deferred to the LAP Engine
// phase — see docs/DATABASE.md and docs/DECISIONS.md for the reasoning.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Identity & multi-tenancy ────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMember[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   OrganizationMember[]
  projects  Project[]
  auditLogs AuditLog[]
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

// ── Project ──────────────────────────────────────────────────────────────

enum ProjectMode {
  INTERNAL
  PRODUCT
  HYBRID
}

model Project {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  description    String?
  mode           ProjectMode @default(HYBRID)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectAgents ProjectAgent[]
  memory        ProjectMemory?
  designMemory  DesignMemory?
}

// ── Agent registry ──────────────────────────────────────────────────────
// Unlike the Phase 0 draft, agent definitions live here as data (not only code),
// so they carry the rich metadata the product spec calls for (system prompt,
// schemas, budget, etc.) and can eventually be managed without a deploy.
// See docs/DECISIONS.md for why this reverses the earlier code-only decision.

enum AgentType {
  EXPERIENCE
  QA
  DESIGN
  STRATEGY
}

enum AgentPriority {
  LOW
  MEDIUM
  HIGH
}

enum ModelTier {
  LOW_COST
  BALANCED
  HIGH_REASONING
}

model Agent {
  id                 String        @id @default(cuid())
  slug               String        @unique // stable code-referenceable id, e.g. "new-user"
  name               String
  type               AgentType
  description        String
  responsibility     String // "what problem do I solve?"
  whenNotToCall      String // "when should I NOT be called?" — required, not decorative
  capabilities       String[]
  systemPrompt       String
  inputSchema        Json // JSON Schema describing expected input
  outputSchema       Json // JSON Schema describing the AGENT/STATUS/FINDING/... contract
  tokenBudget        Int
  priority           AgentPriority @default(MEDIUM)
  recommendedModel   ModelTier     @default(BALANCED)
  version            String        @default("0.1.0")
  enabled            Boolean       @default(false)
  allowedTools       String[]
  supportedTaskTypes String[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  projectAgents ProjectAgent[]
}

model ProjectAgent {
  id        String   @id @default(cuid())
  projectId String
  agentId   String
  enabled   Boolean  @default(true)
  config    Json? // per-project overrides, if any
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent   Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([projectId, agentId])
}

// ── Memory ───────────────────────────────────────────────────────────────
// One row per project. `data` is a structured-but-evolving Json blob (users,
// objectives, recurring problems, opportunities, risks, rules, ...) rather than
// a set of normalized tables — see docs/DATABASE.md for why. Nothing reads or
// writes these yet; they exist so Phase 11 (Memory) has somewhere to land.

model ProjectMemory {
  id        String   @id @default(cuid())
  projectId String   @unique
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DesignMemory {
  id        String   @id @default(cuid())
  projectId String   @unique
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ── Audit ────────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String // e.g. "project.created"
  entityType     String // e.g. "Project"
  entityId       String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
