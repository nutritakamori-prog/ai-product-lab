// AI Product Lab — Foundation + Agent Runtime schema.
// The 9 foundation entities, plus AgentExecution (added in Phase 2 — the
// Runtime's own audit trail of a single agent run). LAP, Finding, Decision,
// Task and TokenUsage remain deferred to the LAP Engine phase — see
// docs/DATABASE.md and docs/DECISIONS.md for the reasoning.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Identity & multi-tenancy ────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMember[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   OrganizationMember[]
  projects  Project[]
  auditLogs AuditLog[]
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

// ── Project ──────────────────────────────────────────────────────────────

enum ProjectMode {
  INTERNAL
  PRODUCT
  HYBRID
}

model Project {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  description    String?
  mode           ProjectMode @default(HYBRID)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectAgents ProjectAgent[]
  memory        ProjectMemory?
  designMemory  DesignMemory?
  executions    AgentExecution[]
  testRuns      TestRun[]
  missionRuns   EvaluationMissionRun[]
}

// ── Agent registry ──────────────────────────────────────────────────────
// Agent BEHAVIOR (system prompt, role, objective, responsibilities,
// constraints, output shape) now lives in versioned files under /agents —
// see docs/DECISIONS.md. This table holds only OPERATIONAL state per agent
// slug: which category/tier it is, its current token budget, and whether
// it's enabled — the things an operator might change without a deploy.
// It does not depend on systemPrompt (or any behavior field) as a source
// of truth anymore.

enum AgentType {
  EXPERIENCE
  QA
  DESIGN
  STRATEGY
  ORCHESTRATION
  // The four specialists added for the full-team evaluation (Head/Command
  // Center phase) — same enum, same table, no parallel agent-type system.
  ACCESSIBILITY
  PRODUCT
  PERFORMANCE
  SECURITY
}

enum ModelTier {
  LOW_COST
  BALANCED
  HIGH_REASONING
}

model Agent {
  id          String    @id @default(cuid())
  slug        String    @unique // matches the file definition's `id`, e.g. "new-user"
  category    AgentType
  modelTier   ModelTier @default(BALANCED)
  tokenBudget Int
  enabled     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projectAgents ProjectAgent[]
  executions    AgentExecution[]
  testRuns      TestRun[]
}

model ProjectAgent {
  id        String   @id @default(cuid())
  projectId String
  agentId   String
  enabled   Boolean  @default(true)
  config    Json? // per-project overrides, if any
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent   Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([projectId, agentId])
}

// ── Agent Runtime execution trail ─────────────────────────────────────────
// One row per agent run. Scoped directly to Project (not to a LAP, which
// doesn't exist yet) — a single agent execution is a lower-level primitive
// than a LAP; when the LAP Engine arrives it groups many of these, it
// doesn't replace this table. See docs/DECISIONS.md.

enum AgentExecutionStatus {
  RUNNING
  SUCCESS
  FAILED
}

// Which ModelProvider actually answered — see src/core/models/provider.ts.
// ANTHROPIC is the real provider; MOCK is the deterministic, offline
// stand-in used automatically when ANTHROPIC_API_KEY isn't configured
// (src/core/models/mock-provider.ts). Recorded explicitly so a MOCK-backed
// execution is never mistaken for a real one. See docs/DECISIONS.md.
enum ModelProviderKind {
  ANTHROPIC
  GEMINI
  // A manual execution reasoned by Claude Code itself (see
  // src/core/runtime/run-agent.ts's toProviderKind()) — injected only via
  // setModelProviderForTesting() for a deliberate, interactive run, never
  // selected automatically by getModelProvider(). Recorded as its own real
  // kind so it's never mistaken for MOCK's deterministic, offline stand-in.
  CLAUDE_CODE
  MOCK
}

model AgentExecution {
  id            String               @id @default(cuid())
  projectId     String
  agentId       String
  task          String
  status        AgentExecutionStatus @default(RUNNING)
  model         String? // the concrete model id actually used, e.g. "claude-sonnet-5"
  provider      ModelProviderKind    @default(ANTHROPIC)
  input         Json // assembled system/user prompt + raw context, for auditability
  output        Json? // the validated structured output, once SUCCESS
  error         String?
  inputTokens   Int?
  outputTokens  Int?
  estimatedCost Float? // USD
  durationMs    Int?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent   Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  testRun TestRun?
}

// ── Test Lab ─────────────────────────────────────────────────────────────
// One row per attempt at a TestScenario. Scenarios themselves are NOT rows
// here — like agent behavior, a scenario is versioned, authored content
// (objective/preconditions/steps/expectedOutcome), so it lives in a file
// under src/core/testing/scenarios/, validated the same way agent
// definitions are. `scenarioId` below is that file's `id`, not a foreign
// key. See src/core/testing/README.md and docs/DECISIONS.md.
//
// Token usage/cost/model are deliberately NOT duplicated here — a TestRun
// that produced an AgentExecution references it via `executionId`, and
// that row already carries those numbers. `durationMs` IS its own field:
// it times the whole test run (setup + step execution + agent call), a
// different measurement than AgentExecution.durationMs (just the model call).

enum TestRunStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
  BLOCKED
  NEEDS_REVIEW
}

model TestRun {
  id              String        @id @default(cuid())
  scenarioId      String // the scenario file's `id`, e.g. "new-user-creates-first-project"
  agentId         String
  projectId       String
  executionId     String?       @unique // the AgentExecution this run produced, once it gets that far
  status          TestRunStatus @default(PENDING)
  observations    Json? // ACTION/EXPECTED/OBSERVED/EVIDENCE entries gathered while attempting the scenario
  observedOutcome String? // what actually happened, to compare against the scenario's expectedOutcome
  findings        Json? // AgentOutput-shaped findings (src/domain/agent-output.ts) the agent produced from the observations
  tracePath       String? // path to this run's Playwright trace .zip (test-results/traces/), when one was captured — complementary structural evidence, never a substitute for `observations`/`findings`
  startedAt       DateTime?
  finishedAt      DateTime?
  durationMs      Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  agent     Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  execution AgentExecution? @relation(fields: [executionId], references: [id])

  // FASE 10B.3: a real, optional retest reference a Validation can point to
  // when a TestRun was the evidence used — never a fabricated link (see
  // Validation below).
  retestValidations Validation[]
}

enum EvaluationMissionRunStatus {
  RUNNING
  COMPLETED
  BLOCKED
  FAILED
}

/**
 * The one addition this phase needed: an EvaluationMission (src/domain/evaluation-mission.ts)
 * was pure data with no persisted identity — every submission through
 * /test-lab's Evaluation Mission form ran for real (via the already-validated
 * runMissionEvaluation()) but its result only ever existed for the single
 * request/response cycle that produced it, gone on refresh. This model gives
 * a Mission's config and outcome a durable identity, so it can be revisited
 * by URL and re-run — nothing about runMissionEvaluation(), the agents, or
 * the consolidation it already does is duplicated or reimplemented here.
 * Same shape/spirit as AgentExecution above: `input`/`report` are the exact
 * same JSON shapes already used elsewhere (a Mission's own config; the
 * existing FinalEvaluationReport), never a second format.
 */
model EvaluationMissionRun {
  id        String                     @id @default(cuid())
  projectId String
  status    EvaluationMissionRunStatus @default(RUNNING)
  input     Json // { target, objective, task, requestedAgents } — the EvaluationMission's own shape, minus id
  report    Json? // FinalEvaluationReport (src/core/findings/mission-evaluation-report.ts), once available
  error     String? // set only when status = FAILED (the orchestration itself threw)
  // The executor this run actually used — same ModelProviderKind enum
  // AgentExecution already uses (src/core/runtime/run-agent.ts's own
  // toProviderKind()), captured once at creation time, before any agent
  // runs. Nullable because a Run created before this field existed has no
  // way to know its own history — never backfilled with a guess. `model`
  // mirrors AgentExecution's own model resolution for one representative
  // requested agent — informational only; each AgentExecution's own
  // `model` remains the authoritative per-agent value.
  provider  ModelProviderKind?
  model     String?
  // The Head's synthesis of `report` above (src/core/findings/head-report.ts)
  // — a separate, additive column rather than a new field inside `report`,
  // so FinalEvaluationReport's own shape (already relied on by MissionReport
  // and every existing consumer) stays completely untouched. Null exactly
  // when `report` itself is null (FAILED runs, or runs from before this
  // column existed) — never backfilled with a guess.
  headReport Json?
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recommendations Recommendation[]

  // FASE 10B.3: a real, optional retest reference a Validation can point to
  // when this Mission run was the evidence used to validate an
  // Implementation — never a fabricated link (see Validation below).
  retestValidations Validation[]

  @@index([projectId])
}

enum RecommendationStatus {
  PENDING
  APPROVED
  IGNORED
}

/**
 * The minimal persistent unit the human-decision loop actually needs: one
 * row per consolidated finding (mission-evaluation-report.ts's own
 * ConsolidatedFinding — never re-deduplicated or re-consolidated here),
 * created once when its EvaluationMissionRun completes, carrying the Head's
 * own framing of it (title/summary/whyItMatters/recommendedAction — plain
 * text, never re-derived later) plus a `status` a human can move from
 * PENDING to APPROVED or IGNORED. `findingIndex` is that finding's position
 * in the run's own `report.findings` array — stable because a completed
 * run's report is never regenerated. IMPLEMENTED/VERIFIED intentionally
 * don't exist yet — those belong to a future execution/verification phase,
 * not this one (see docs/DECISIONS.md).
 */
model Recommendation {
  id                String               @id @default(cuid())
  missionRunId      String
  findingIndex      Int
  title             String
  summary           String
  whyItMatters      String
  recommendedAction String
  impact            String? // mirrors AgentOutput's own IMPACT_LEVELS string, never a new enum for the same values
  confidence        String? // mirrors AgentOutput's own CONFIDENCE_LEVELS string
  status            RecommendationStatus @default(PENDING)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  missionRun     EvaluationMissionRun @relation(fields: [missionRunId], references: [id], onDelete: Cascade)
  implementation Implementation?

  @@unique([missionRunId, findingIndex])
}

// ── Recommendation → Implementation → Validation ────────────────────────
// FASE 10B.3: the one gap the FASE 10A audit found completely missing —
// nothing persisted the fact that an APPROVED Recommendation was actually
// acted on, or that a later retest confirmed/refuted it. See
// docs/DECISIONS.md-style reasoning inline below.

enum ImplementationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

/**
 * One row per Recommendation that has moved past a human decision into real
 * work — created only once that Recommendation is APPROVED (enforced in
 * src/services/implementations.ts, not here: Postgres has no portable way
 * to check a sibling row's status without a trigger, which this phase
 * deliberately avoids). Deliberately NOT a duplicate of ImplementationTask
 * (src/services/implementation-task.ts) — that stays exactly what it always
 * was, a rich view derived fresh from a Recommendation + its
 * EvaluationMissionRun every time it's requested, never persisted. This
 * table only tracks the fact and state of the work itself: whether it
 * happened, when, and a short free-text summary — never the task content.
 *
 * recommendationId is @unique: at most one Implementation per
 * Recommendation. A Recommendation whose first implementation attempt
 * turns out not to have fixed the problem gets a new Validation on the same
 * Implementation (see below), not a second Implementation row — this phase
 * deliberately doesn't model multiple independent implementation attempts.
 *
 * No direct projectId — same precedent as Recommendation itself just
 * above, which also has none: isolation is enforced by always joining
 * through recommendation.missionRun.projectId (see
 * src/services/implementations.ts), never a denormalized copy that could
 * drift from it.
 */
model Implementation {
  id               String               @id @default(cuid())
  recommendationId String               @unique
  status           ImplementationStatus @default(PENDING)
  summary          String? // free-text description of what was actually done, optional
  createdAt        DateTime             @default(now())
  completedAt      DateTime?
  updatedAt        DateTime             @updatedAt

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  validations    Validation[]
}

enum ValidationStatus {
  PENDING
  PASSED
  FAILED
  INCONCLUSIVE
}

/**
 * One retest/validation attempt against an existing Implementation — never
 * orphaned (implementationId is a required FK, enforced by Postgres).
 * retestMissionRunId/retestTestRunId are real, optional FKs to the actual
 * evidence used, when there is any safe one to point to — never a
 * fabricated link; both stay null when a Validation was recorded without a
 * corresponding automated re-run (e.g. a human manually confirmed the fix).
 * An Implementation can have more than one Validation over time (e.g. a
 * first retest INCONCLUSIVE, a later one PASSED) — never collapsed to a
 * single latest state.
 *
 * onDelete: SetNull on both retest references (unlike the Cascade used
 * everywhere else in this schema) because a Validation's own recorded
 * outcome should survive its evidence row being cleaned up later, never be
 * silently deleted along with it.
 */
model Validation {
  id                 String           @id @default(cuid())
  implementationId   String
  status             ValidationStatus @default(PENDING)
  retestMissionRunId String?
  retestTestRunId    String?
  notes              String? // free-text, optional
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  implementation   Implementation        @relation(fields: [implementationId], references: [id], onDelete: Cascade)
  retestMissionRun EvaluationMissionRun? @relation(fields: [retestMissionRunId], references: [id], onDelete: SetNull)
  retestTestRun    TestRun?              @relation(fields: [retestTestRunId], references: [id], onDelete: SetNull)

  @@index([implementationId])
}

// ── Memory ───────────────────────────────────────────────────────────────
// One row per project. `data` is a structured-but-evolving Json blob (users,
// objectives, recurring problems, opportunities, risks, rules, ...) rather than
// a set of normalized tables — see docs/DATABASE.md for why. Nothing reads or
// writes these yet; they exist so Phase 11 (Memory) has somewhere to land.

model ProjectMemory {
  id        String   @id @default(cuid())
  projectId String   @unique
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DesignMemory {
  id        String   @id @default(cuid())
  projectId String   @unique
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ── Audit ────────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String // e.g. "project.created"
  entityType     String // e.g. "Project"
  entityId       String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
