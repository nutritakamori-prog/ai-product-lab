# Copy this file to .env and fill in the real values. Never commit .env.

# Local Postgres (matches docker-compose.yml). If you use `docker compose up -d`
# or a native local Postgres with the same user/password/db, this works as-is.
DATABASE_URL="postgresql://ai_product_lab:ai_product_lab@localhost:5432/ai_product_lab?schema=public"

# Anthropic API key used by the Agent Runtime to call Claude models.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Optional, free-tier alternative to ANTHROPIC_API_KEY — used only when
# ANTHROPIC_API_KEY above is empty. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Optional — lets the QG's Operational Brain answer "which repos do I have
# on GitHub?" for real. A GitHub Personal Access Token (classic: repo +
# read:user scopes; fine-grained: Metadata read + Contents read on the repos
# you want visible). Without this, the Brain says GitHub isn't configured
# instead of guessing or fabricating repos.
GITHUB_API_TOKEN=""
