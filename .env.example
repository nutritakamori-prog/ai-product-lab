# Copy this file to .env and fill in the real values. Never commit .env.

# Local Postgres (matches docker-compose.yml). If you use `docker compose up -d`
# or a native local Postgres with the same user/password/db, this works as-is.
DATABASE_URL="postgresql://ai_product_lab:ai_product_lab@localhost:5432/ai_product_lab?schema=public"

# Anthropic API key used by the Agent Runtime to call Claude models.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
